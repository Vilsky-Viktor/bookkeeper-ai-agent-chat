# LLM — LLM_PROVIDER selects openai (default), anthropic, or google; LLM_API_KEY must
# match whichever provider is selected. See README > "Swapping the LLM provider".
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o
LLM_SUMMARY_MODEL=gpt-4o-mini
# Receipt reading: gpt-4o-mini bills images at a large multiplier (no cheaper) and
# reads receipts less reliably, so this stays on gpt-4o.
LLM_VISION_MODEL=gpt-4o
# The transactions service's categorizer. gpt-4o-mini is ~16x cheaper but misfiles
# brand-only item names more often (see services/transactions/app/categorize.py).
LLM_CATEGORIZE_MODEL=gpt-4o

# LangSmith (optional — tracing no-ops locally if these are unset)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smaker-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
