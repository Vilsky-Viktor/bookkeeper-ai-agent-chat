# LLM — LLM_PROVIDER selects openai (default), anthropic, or google; LLM_API_KEY must
# match whichever provider is selected. See README > "Swapping the LLM provider".
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=gpt-4o
LLM_SUMMARY_MODEL=gpt-6-luna
LLM_VISION_MODEL=gpt-6-luna
LLM_CATEGORIZE_MODEL=gpt-6-luna
# gpt-6-luna is a reasoning model: none, low, medium, ... (medium by default).
LLM_REASONING_EFFORT=medium

# LangSmith (optional — tracing no-ops locally if these are unset)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smaker-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
